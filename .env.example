# Copy to .env and fill in before running `docker compose up`.
# The backend, worker and beat containers read this file (see
# docker-compose.yml); DATABASE_URL/REDIS_URL are overridden there to point
# at the postgres/redis containers regardless of what is set here.

# Anything other than "development" makes the app REFUSE to start while the
# two secrets below are still placeholders.
ENVIRONMENT=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Device passwords are encrypted with this. Back it up with the database;
# without it the stored credentials cannot be recovered.
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key
# Rotating the key: put the old one(s) here, comma-separated. Stored
# passwords keep decrypting and are re-encrypted with the new key when the
# API starts; then this line can be removed. The built-in placeholder key
# is always accepted as a previous key, so moving off it needs nothing here.
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

DEVICE_CONNECT_TIMEOUT=20

# Optional: logging (see backend/app/core/logging_config.py)
# LOG_LEVEL=INFO
# LOG_DOWNLOAD_ENABLED=true

# Optional: login brute-force protection
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=30
