# Copy to .env and adjust before running `docker compose up`.
# Values here are consumed by the backend and worker containers
# (see docker-compose.yml); DATABASE_URL/REDIS_URL are overridden there
# to point at the postgres/redis containers regardless of what's set here.

JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key

DEVICE_CONNECT_TIMEOUT=20

# Firmware push (see README's "Pushing firmware to devices" section).
#
# Hostname/IP the managed devices themselves should use to reach the
# scp-server container - it must be routable from your device network, not
# just from inside docker compose. There is no safe default; firmware
# pushes fail fast with a clear error until this is set.
SCP_SERVER_PUBLIC_HOST=change-me-to-an-address-your-devices-can-reach
SCP_SERVER_PORT=2222
